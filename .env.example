# Copy to a private env file for Compose. These defaults target loopback and local TLS.
FITSTUDIO_DOMAIN=fitstudio.localhost
FITSTUDIO_HTTPS_PORT=8443
FITSTUDIO_HTTP_BIND=127.0.0.1:8080
FITSTUDIO_HTTPS_BIND=127.0.0.1:8443
FITSTUDIO_CADDYFILE=./deploy/Caddyfile.local

# Required for production settings. Generate a unique secret locally and keep it private.
FITSTUDIO_SECRET_KEY=

# Compose fixes the SQLite file at /data/fitstudio.sqlite3 in the studio_data volume.

# IDs belong to this installation. Leave unset until the records exist.
FITSTUDIO_QUICK_COURSE_TYPE_ID=
FITSTUDIO_BOOKING_MAX_DAYS=
FITSTUDIO_BOOKING_COACH_ID=
FITSTUDIO_BOOKING_COURSE_TYPE_ID=

# Optional for local Python runs only. Compose selects config.production_settings itself.
# DJANGO_SETTINGS_MODULE=config.dev_settings
# FITSTUDIO_DEV_HOST=
# FITSTUDIO_DB_PATH=/absolute/path/to/new.sqlite3
